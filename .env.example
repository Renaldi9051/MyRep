# Salin ke .env (di root repo) lalu isi. Jangan commit .env.

# --- BE (rahasia, JANGAN diberi awalan VITE_) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Atau database lokal di Docker (pnpm db:up, lihat docker-compose.dev.yml):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/myrep
BETTER_AUTH_SECRET=
# Untuk lokal. Di Docker (VPS) otomatis diganti https://DOMAIN oleh docker-compose.yml
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Deploy (Caddy) ---
# Subdomain DuckDNS asli yang mengarah ke IP VPS (tanpa https://)
DOMAIN=namaapp.duckdns.org

# --- FE (terbaca di browser) ---
VITE_API_URL=/api
